{
  "name": "dsh-cny-cost",
  "version": "0.2.0",
  "description": "DSH Web plugin that shows the theoretical CNY cost of DeepSeek official model usage under the composer and at the end of every turn, and watches the official pricing page for changes with a one-click rule-update session.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "token-cost",
    "pricing",
    "cny"
  ],
  "homepage": "https://github.com/FeiYuSS/dsh-cny-cost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeiYuSS/dsh-cny-cost.git"
  },
  "bugs": {
    "url": "https://github.com/FeiYuSS/dsh-cny-cost/issues"
  },
  "license": "MIT",
  "author": {
    "name": "FeiYuSS",
    "url": "https://github.com/FeiYuSS"
  },
  "icon": "./icon.svg",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "logic.js",
    "client.js",
    "pricing-watch.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "scripts"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test",
    "check:locale": "node scripts/check-locale-keys.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run test && npm run check:locale && npm run check:package",
    "verify:host": "node scripts/verify-against-host.mjs",
    "sync:pricing": "node scripts/sync-pricing-mirror.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
